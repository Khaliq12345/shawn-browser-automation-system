# --- Stage 1: Builder ---
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files from the interface directory
COPY interface/package.json interface/package-lock.json ./interface/

# Move into the interface directory to install dependencies locally there
WORKDIR /app/interface

# Use npm ci for reliable, non-interactive, reproducible builds in containers
RUN npm ci

# Copy the rest of the application source code into the current working directory (/app/interface)
COPY interface/ .

# Run the build command
RUN npm run build


# --- Stage 2: Production Runtime ---
FROM node:22-alpine AS production

WORKDIR /app

# Copy the build output from the builder stage
COPY --from=builder /app/interface/.output ./interface/.output

EXPOSE 3000
ENV NODE_ENV production

CMD [ "node", "./interface/.output/server/index.mjs" ]
